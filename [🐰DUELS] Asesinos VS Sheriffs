-- Esquinas redondeadas
local cornerFarm = Instance.new("UICorner")
cornerFarm.CornerRadius = UDim.new(0, 12)
cornerFarm.Parent = farmButton

-- ========== TEXTO "by El pepe" ==========
local creditLabel = Instance.new("TextLabel")
creditLabel.Size = UDim2.new(0, 150, 0, 30)
creditLabel.Position = UDim2.new(0.5, -75, 0.55, 0)
creditLabel.Text = "by El pepe"
creditLabel.TextScaled = true
creditLabel.BackgroundTransparency = 1
creditLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
creditLabel.TextXAlignment = Enum.TextXAlignment.Center
creditLabel.Parent = screenGui

-- ========== ACCIÓN AL PRESIONAR EL BOTÓN DE FARMEO ==========
farmButton.MouseButton1Click:Connect(function()
    if not farmingActive then
        startFarming()
        -- Feedback visual
        farmButton.Text = "¡Farm activado!"
        farmButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        task.wait(1)
        farmButton.Text = "Farm huevos Duels"
        farmButton.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    end
end)

-- Efecto hover
farmButton.MouseEnter:Connect(function()
    TweenService:Create(farmButton, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
end)

farmButton.MouseLeave:Connect(function()
    TweenService:Create(farmButton, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
end)
